# Keep local artifacts out of Git by default. Only explicitly allowed project
# files below appear in git status/add. Add an exception for new modules.
*

# Project entry points and installation instructions
!/.gitignore
!/README.md
!/requirements.txt
!/__init__.py
!/main.py
!/train.py
!/infer.py
!/benchmark_efficiency.py

# Runtime modules: Python source only, without data/caches/checkpoints
!/models/
!/models/*.py
!/utils/
!/utils/*.py
!/dataset/
!/dataset/__init__.py
!/dataset/dataset.py

# Runtime configuration
!/configs/
!/configs/*.json
!/configs/*.yaml
!/configs/*.yml

# Download, preprocessing, training, inference and experiment management
!/scripts/
!/scripts/__init__.py
!/scripts/dataset_download.py
!/scripts/prepare_dataset.sh
!/scripts/run_experiment.ps1
!/scripts/manage_checkpoints.py
!/scripts/mirror_attention.py
!/scripts/summarize_experiments.py

# Tests, audit/check/preflight tools, docs, papers, legacy code, notebooks,
# images, videos, results, weights, logs and environments stay local.
